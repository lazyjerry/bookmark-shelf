{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bookmark-shelf",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-19",
  // 靜態頁面也要經過 Basic Auth，所以讓 Worker 先執行
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bookmark-shelf",
      "migrations_dir": "migrations"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "vars": {
    "AUTH_USER": "admin",
    "AI_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
    "AI_ENABLED": "true"
  },
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  }
}
